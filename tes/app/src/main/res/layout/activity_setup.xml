<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff5f5f5"
    android:fillViewport="true" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_white"
            android:orientation="horizontal"
            android:padding="16dp" >

            <TextView
                android:id="@+id/tv_images_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_images_selected"
                android:textColor="#ff212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_reselect_images"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="0dp"
                android:background="@drawable/btn_secondary"
                android:text="@string/btn_reselect_images"
                android:textColor="#ffffffff"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_white"
            android:orientation="vertical"
            android:padding="16dp" >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/setup_compression_title"
                android:textColor="#ff212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/setup_compression_level"
                android:textColor="#ff424242"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_compression_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/setup_compression_quality"
                android:textColor="#ff2196f3"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekbar_compression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50" />

            <TextView
                android:id="@+id/tv_estimated_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/setup_estimated_size"
                android:textColor="#ff757575"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/chk_grayscale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/setup_grayscale"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/chk_remove_metadata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/setup_remove_metadata"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_white"
            android:orientation="vertical"
            android:padding="16dp" >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/setup_image_size_title"
                android:textColor="#ff212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/setup_image_width"
                android:textColor="#ff424242"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_image_width_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/setup_width_value"
                android:textColor="#ff4caf50"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekbar_image_width"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="95"
                android:progress="25" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/setup_width_info"
                android:textColor="#ff757575"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_white"
            android:orientation="vertical"
            android:padding="16dp" >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/setup_visual_title"
                android:textColor="#ff212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switch_show_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/setup_show_all"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/switch_show_borders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/setup_show_borders"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/switch_show_dimensions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/setup_show_dimensions"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/switch_show_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/setup_show_row"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/switch_show_resolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/setup_show_resolution"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/switch_show_scale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_show_scale"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_start_conversion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_success"
            android:paddingBottom="16dp"
            android:paddingTop="16dp"
            android:text="@string/btn_start_conversion"
            android:textColor="#ffffffff"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</ScrollView>