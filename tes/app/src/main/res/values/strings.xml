    <!-- AboutActivity -->
    <string name="about_app_title">Image to PDF Converter</string>
    <string name="about_version">Versi 1.0</string>
    <string name="about_description">Aplikasi konversi gambar ke PDF yang mudah dan cepat. Mendukung kompresi, pengaturan ukuran, dan berbagai fitur kustomisasi.</string>
    <string name="about_features_title">Fitur Utama:</string>
    <string name="about_feature1">• Konversi multiple gambar sekaligus</string>
    <string name="about_feature2">• 5 level kompresi (None - Maximum)</string>
    <string name="about_feature3">• Pengaturan ukuran gambar dalam PDF</string>
    <string name="about_feature4">• Konversi Grayscale opsional</string>
    <string name="about_feature5">• Hapus metadata untuk privasi</string>
    <string name="about_feature6">• Tak perlu buka aplikasi rich text editor(canva, word, dan wps) dan atur foto satu persatu</string>
	<string name="about_feature7">• Dibuat untuk merigankan beban anak kimia UIN(walapun sedikit)</string>   
